{
  "name": "cuetscript",
  "version": "0.1.0-dev.1",
  "private": true,
  "description": "Local multi-model roleplaying runtime",
  "type": "module",
  "engines": {
    "node": ">=26 <27"
  },
  "bin": {
    "cuet": "dist/cli/index.js",
    "cuet-web": "dist/web/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && vitest run",
    "check": "npm run typecheck && npm test",
    "cuet": "node dist/cli/index.js",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/*.mjs\"",
    "web": "node dist/web/index.js"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "commander": "15.0.0",
    "fast-json-patch": "3.1.1",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@types/node": "26.5.0",
    "prettier": "3.9.6",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  },
  "files": [
    "dist",
    "examples",
    "docs",
    "third-party",
    "README.md",
    "src"
  ]
}
